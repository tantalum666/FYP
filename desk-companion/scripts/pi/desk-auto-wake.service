[Unit]
Description=Renew Desk Companion's opted-in RTC wake alarm
DefaultDependencies=no
Wants=local-fs.target
After=local-fs.target systemd-remount-fs.service
Conflicts=shutdown.target
ConditionPathExists=/var/lib/desk-auto-wake/enabled
ConditionPathExists=/sys/class/rtc/rtc0/wakealarm
Before=sysinit.target user@1000.service display-manager.service shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/desk-companion/auto_wake.py arm --delay 180
UMask=0077
TimeoutStartSec=10

[Install]
WantedBy=sysinit.target
