# Copy to .runtime/service.env on the target host; chmod 600. Never commit secrets.
DESK_NATIVE_CLIENTS=1
# Local browser and workers use loopback. Set this only with the matching TLS proxy:
# DESK_PUBLIC_ORIGIN=https://desk.example.test
# OpenAI is the default. No inference starts until the owner uses chat/voice/Work.
# Keep the approved project key in an owner-private 0600 file; never paste it here.
DESK_OPENAI_CREDENTIAL_FILE=
DESK_VOICE_PROVIDER=openai_realtime
DESK_VOICE_MODEL=gpt-realtime-2.1
DESK_VOICE_ENDPOINT=wss://api.openai.com/v1/realtime
DESK_VOICE_API_KEY=
DESK_VOICE_VOICE=marin
# Qwen/Gemini adapters remain available for explicit comparisons.
DESK_QWEN_CREDENTIAL_FILE=
DESK_GOOGLE_CLIENT_ID=
DESK_GOOGLE_CLIENT_SECRET=
DESK_GOOGLE_REDIRECT_URI=
# Replay belongs only in an isolated demonstration database.
DESK_ALLOW_REPLAY=0

# Work and ordinary HTTP text use the same approved OpenAI key file.
DESK_TEXT_PROVIDER=openai
DESK_TEXT_MODEL=gpt-6.1-sol
DESK_TEXT_ENDPOINT=https://api.openai.com/v1/responses
DESK_TEXT_API_KEY=
# Background suggestions are opt-in; ordinary persistent check-ins work without AI.
DESK_TEXT_BACKGROUND=0

# Opt in only to application-owned notes. Never enables desktop, shell, or LCU access.
# Owner approval is required for each save or verification. Files remain in
# DESK_RUNTIME_DIR/computer-notes; no arbitrary input paths or overwrites.
DESK_COMPUTER_ENABLED=0
